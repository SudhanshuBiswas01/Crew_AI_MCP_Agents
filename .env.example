# ─────────────────────────────────────────────────────────────
#  Operations Assistant — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# ── Model Configuration ──────────────────────────────────────
# OpenAI-compatible API key (leave blank if using Ollama locally)
OPENAI_API_KEY=your-openai-api-key-here

# Model name to use for agents
# Examples: gpt-4o-mini | ollama/llama3 | ollama/mistral
MODEL_NAME=ollama/llama3

# Base URL — set this if using Ollama or a custom OpenAI-compatible endpoint
# Leave blank for the real OpenAI API
OPENAI_API_BASE=http://localhost:11434

# ── MCP Server Configuration ─────────────────────────────────
# Transport type: stdio | sse | http
MCP_TRANSPORT=stdio

# SSE/HTTP host and port (only needed if MCP_TRANSPORT != stdio)
MCP_HOST=127.0.0.1
MCP_PORT=8000

# ── Data Paths ───────────────────────────────────────────────
# Relative or absolute path to the documents folder
DOCS_DIR=./docs

# Relative or absolute path to the records CSV
RECORDS_CSV=./data/inventory_orders.csv

# Relative or absolute path where save_report() writes output
OUTPUT_DIR=./output

# ── Agent Settings ───────────────────────────────────────────
# Maximum iterations per agent (prevents runaway loops)
AGENT_MAX_ITER=10

# Enable verbose CrewAI output: true | false
CREW_VERBOSE=true

# ── Tracing ──────────────────────────────────────────────────
# Directory where run traces are saved
TRACES_DIR=./traces
