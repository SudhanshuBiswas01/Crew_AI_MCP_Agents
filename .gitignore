# ── Secrets ──────────────────────────────────────────────────
.env

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# ── uv / virtualenv ──────────────────────────────────────────
.venv/
venv/
